function is_seapath_clustering_enable() {
    local required_services=(
        pacemaker
        corosync
    )

    for service in "${required_services[@]}"; do
        if systemctl list-units | grep -q "${service}.service"; then
            continue
        else
            return 1
        fi
    done
    return 0
}
