SEAPATH_AUTO_FLASH="@@SEAPATH_AUTO_FLASH@@"

if [ -n "$SEAPATH_AUTO_FLASH" ]; then
    if [ "$(tty 2>/dev/null)" = "/dev/tty1" ]; then
        if touch /run/seapath-auto-flash.started 2>/dev/null; then
            echo "Auto flash enabled on $SEAPATH_AUTO_FLASH."

            if auto-flash start; then
                echo "Auto flash returned successfully; awaiting reboot."
            else
                status=$?
                printf 'Auto flash failed (exit status %s).\n' "$status" >&2
                echo "Automatic retry is disabled for this boot." >&2
            fi
        elif [ -e /run/seapath-auto-flash.started ]; then
            echo "Auto flash has already been started this boot."
        else
            echo "Cannot create auto-flash startup marker; not flashing." >&2
        fi
    fi
else
    echo "Auto flash disabled."
    echo "To flash manually:"
    flash --help
    echo "Images can be found in /media."
fi
