From ecc6fe9cc1f0677b6c640a755d1414993b5d0410 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Mathieu=20Dupr=C3=A9?= <mathieu.dupre@savoirfairelinux.com>
Date: Tue, 1 Oct 2024 16:27:25 +0200
Subject: [PATCH] fix cross-compilation with python cython modules
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Upstream-Status: Inappropriate [oe specific]

Signed-off-by: Mathieu Dupré <mathieu.dupre@savoirfairelinux.com>

---
 cmake/modules/Distutils.cmake | 14 +++---
 src/pybind/cephfs/setup.py    | 95 ++++++++---------------------------
 src/pybind/rados/setup.py     | 91 ++++++++-------------------------
 src/pybind/rbd/setup.py       | 93 ++++++++--------------------------
 src/pybind/rgw/setup.py       | 93 ++++++++--------------------------
 5 files changed, 96 insertions(+), 290 deletions(-)

Index: ceph-18.2.7/cmake/modules/Distutils.cmake
===================================================================
--- ceph-18.2.7.orig/cmake/modules/Distutils.cmake
+++ ceph-18.2.7/cmake/modules/Distutils.cmake
@@ -37,6 +37,7 @@ function(distutils_install_module name)
     if(NOT \"${DU_INSTALL_SCRIPT}\" STREQUAL \"\")
       list(APPEND options --install-script=${DU_INSTALL_SCRIPT})
     endif()
+    list(APPEND options --install-lib=${PYTHON_SITEPACKAGES_DIR})
     execute_process(
     COMMAND ${Python3_EXECUTABLE}
         setup.py install \${options}
@@ -53,8 +54,6 @@ function(distutils_add_cython_module tar
   # distutils tries to execve something like "/usr/bin/cmake gcc" and fails.
   # Removing the leading whitespace from CMAKE_C_COMPILER_ARG1 helps to avoid
   # the failure.
-  string(STRIP "${CMAKE_C_COMPILER_ARG1}" c_compiler_arg1)
-  string(STRIP "${CMAKE_CXX_COMPILER_ARG1}" cxx_compiler_arg1)
   # Note: no quotes, otherwise distutils will execute "/usr/bin/ccache gcc"
   # CMake's implicit conversion between strings and lists is wonderful, isn't it?
   set(PY_CFLAGS ${COMPILE_OPTIONS})
@@ -67,9 +66,10 @@ function(distutils_add_cython_module tar
   # Note: this is reproduced in distutils_install_cython_module
   list(APPEND PY_CPPFLAGS -D'void0=dead_function\(void\)')
   list(APPEND PY_CPPFLAGS -D'__Pyx_check_single_interpreter\(ARG\)=ARG\#\#0')
-  set(PY_CC ${compiler_launcher} ${CMAKE_C_COMPILER} ${c_compiler_arg1})
-  set(PY_CXX ${compiler_launcher} ${CMAKE_CXX_COMPILER} ${cxx_compiler_arg1})
-  set(PY_LDSHARED ${link_launcher} ${CMAKE_C_COMPILER} ${c_compiler_arg1} "-shared")
+  list(APPEND PY_CPPFLAGS -I${CMAKE_SOURCE_DIR}/src/include -I${CMAKE_SOURCE_DIR}/src -I${CMAKE_BINARY_DIR}/include)
+  set(PY_CC ${CC} ${PY_CPPFLAGS} ${PY_CFLAGS} -L${CMAKE_LIBRARY_OUTPUT_DIRECTORY})
+  set(PY_CXX ${CXX} ${PY_CPPFLAGS} ${PY_CFLAGS} -L${CMAKE_LIBRARY_OUTPUT_DIRECTORY})
+  set(PY_LDSHARED ${LD} ${LDFLAGS} "-shared")
 
   execute_process(COMMAND "${Python3_EXECUTABLE}" -c
     "import sysconfig; print(sysconfig.get_config_var('EXT_SUFFIX'))"
@@ -89,13 +89,7 @@ function(distutils_add_cython_module tar
     OUTPUT ${output_dir}/${name}${ext_suffix}
     COMMAND
     env
-    CC="${PY_CC}"
-    CFLAGS="${PY_CFLAGS}"
-    CPPFLAGS="${PY_CPPFLAGS}"
-    CXX="${PY_CXX}"
-    LDSHARED="${PY_LDSHARED}"
-    OPT=\"-DNDEBUG -g -fwrapv -O2 -w\"
-    LDFLAGS=-L${CMAKE_LIBRARY_OUTPUT_DIRECTORY}
+    CPPFLAGS=\"-iquote${CMAKE_SOURCE_DIR}/src/include -D'void0=dead_function\(void\)' -D'__Pyx_check_single_interpreter\(ARG\)=ARG\#\#0' ${CFLAG_DISABLE_VTA} -L${CMAKE_BINARY_DIR}/lib \"
     CYTHON_BUILD_DIR=${CMAKE_CURRENT_BINARY_DIR}
     CEPH_LIBDIR=${CMAKE_LIBRARY_OUTPUT_DIRECTORY}
     ${Python3_EXECUTABLE} ${setup_py}
@@ -111,8 +105,6 @@ endfunction(distutils_add_cython_module)
 function(distutils_install_cython_module name)
   get_property(compiler_launcher GLOBAL PROPERTY RULE_LAUNCH_COMPILE)
   get_property(link_launcher GLOBAL PROPERTY RULE_LAUNCH_LINK)
-  set(PY_CC "${compiler_launcher} ${CMAKE_C_COMPILER}")
-  set(PY_LDSHARED "${link_launcher} ${CMAKE_C_COMPILER} -shared")
   cmake_parse_arguments(DU "DISABLE_VTA" "" "" ${ARGN})
   if(DU_DISABLE_VTA AND HAS_VTA)
     set(CFLAG_DISABLE_VTA -fno-var-tracking-assignments)
@@ -121,22 +113,19 @@ function(distutils_install_cython_module
     set(maybe_verbose --verbose)
   endif()
   install(CODE "
-    set(ENV{CC} \"${PY_CC}\")
-    set(ENV{LDSHARED} \"${PY_LDSHARED}\")
-    set(ENV{CPPFLAGS} \"-iquote${CMAKE_SOURCE_DIR}/src/include
+    set(ENV{CPPFLAGS} \"-iquote${CMAKE_SOURCE_DIR}/src/include \
                         -D'void0=dead_function\(void\)' \
                         -D'__Pyx_check_single_interpreter\(ARG\)=ARG\#\#0' \
-                        ${CFLAG_DISABLE_VTA}\")
-    set(ENV{LDFLAGS} \"-L${CMAKE_LIBRARY_OUTPUT_DIRECTORY}\")
-    set(ENV{CYTHON_BUILD_DIR} \"${CMAKE_CURRENT_BINARY_DIR}\")
+                        ${CFLAG_DISABLE_VTA} \
+                        -L${CMAKE_BINARY_DIR}/lib \")
     set(ENV{CEPH_LIBDIR} \"${CMAKE_LIBRARY_OUTPUT_DIRECTORY}\")
-
     set(options --prefix=${CMAKE_INSTALL_PREFIX})
     if(DEFINED ENV{DESTDIR})
       list(APPEND options --root=\$ENV{DESTDIR})
     else()
       list(APPEND options --root=/)
     endif()
+    list(APPEND options --install-lib=${PYTHON_SITEPACKAGES_DIR})
     execute_process(
        COMMAND
            ${Python3_EXECUTABLE} ${CMAKE_CURRENT_SOURCE_DIR}/setup.py
