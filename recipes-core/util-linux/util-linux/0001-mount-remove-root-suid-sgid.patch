From a9bf339a153b47f23e3b99da413e9c3a1e5c8b2c Mon Sep 17 00:00:00 2001
From: Enguerrand de Ribaucourt <enguerrand.de-ribaucourt@savoirfairelinux.com>
Date: Tue, 24 Mar 2026 10:34:14 +0100
Subject: [PATCH] mount: remove root suid/sgid

Following ANSSI-BP28-R57, sudo is preferred to using mount with suid.

Upstream-Status: Inappropriate [Seapath specific]
Signed-off-by: Enguerrand de Ribaucourt <enguerrand.de-ribaucourt@savoirfairelinux.com>
Signed-off-by: Paul Le Guen de Kerneizon <paul.leguendekerneizon@savoirfairelinux.com>
---
 Makefile.in             |  6 ------
 sys-utils/Makemodule.am | 15 ---------------
 2 files changed, 21 deletions(-)

diff --git a/Makefile.in b/Makefile.in
index 71ca210..eafa467 100644
--- a/Makefile.in
+++ b/Makefile.in
@@ -764,7 +764,6 @@ check_PROGRAMS = test_blkdev$(EXEEXT) test_buffer$(EXEEXT) \
 
 @BUILD_MOUNT_TRUE@@HAVE_STATIC_MOUNT_TRUE@am__append_389 = mount.static
 @BUILD_MOUNT_TRUE@@HAVE_STATIC_UMOUNT_TRUE@am__append_390 = umount.static
-@BUILD_MOUNT_TRUE@am__append_391 = install-exec-hook-mount
 @BUILD_SWAPON_TRUE@am__append_392 = swapon swapoff
 @BUILD_SWAPON_TRUE@am__append_393 = sys-utils/swapon.8
 @BUILD_SWAPON_TRUE@am__append_394 = sys-utils/swapon.8.adoc
@@ -19492,11 +19491,6 @@ install-exec-hook:
 @BUILD_SETARCH_TRUE@		rm -f $(DESTDIR)$(usrbin_execdir)/$$I ; \
 @BUILD_SETARCH_TRUE@	done
 
-@BUILD_MOUNT_TRUE@install-exec-hook-mount:
-@BUILD_MOUNT_TRUE@@MAKEINSTALL_DO_CHOWN_TRUE@	chown root:root $(DESTDIR)$(bindir)/mount
-@BUILD_MOUNT_TRUE@@MAKEINSTALL_DO_SETUID_TRUE@	chmod 4755 $(DESTDIR)$(bindir)/mount
-@BUILD_MOUNT_TRUE@@MAKEINSTALL_DO_CHOWN_TRUE@	chown root:root $(DESTDIR)$(bindir)/umount
-@BUILD_MOUNT_TRUE@@MAKEINSTALL_DO_SETUID_TRUE@	chmod 4755 $(DESTDIR)$(bindir)/umount
 errnos.h: $(top_srcdir)/tools/all_errnos
 	@echo '  GEN      $@'
 	@$(top_srcdir)/tools/all_errnos "$(SED)" "$@" $(CC) $(CFLAGS)
diff --git a/sys-utils/Makemodule.am b/sys-utils/Makemodule.am
index 35a1e20..92ff469 100644
--- a/sys-utils/Makemodule.am
+++ b/sys-utils/Makemodule.am
@@ -391,21 +391,6 @@ umount_static_LDFLAGS = $(umount_LDFLAGS) -all-static
 umount_static_LDADD = $(umount_LDADD)
 endif
 
-install-exec-hook-mount:
-if MAKEINSTALL_DO_CHOWN
-	chown root:root $(DESTDIR)$(bindir)/mount
-endif
-if MAKEINSTALL_DO_SETUID
-	chmod 4755 $(DESTDIR)$(bindir)/mount
-endif
-if MAKEINSTALL_DO_CHOWN
-	chown root:root $(DESTDIR)$(bindir)/umount
-endif
-if MAKEINSTALL_DO_SETUID
-	chmod 4755 $(DESTDIR)$(bindir)/umount
-endif
-
-INSTALL_EXEC_HOOKS += install-exec-hook-mount
 endif # BUILD_MOUNT
 
 
