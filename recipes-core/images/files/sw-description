software =
{
    version = "@@DISTRO_VERSION@@";

    images: (
        {
            filename = "@@IMAGE_DEPENDS@@-boot.tar.xz";
            filesystem = "vfat";
            type = "archive";
            device = "/dev/upgradable_bootloader";
            path = "/";
            sha256 = "$swupdate_get_sha256(@@IMAGE_DEPENDS@@-boot.tar.xz)";
        },
        {
            filename = "@@IMAGE_DEPENDS@@-@@MACHINE@@.rootfs.tar.xz";
            filesystem = "ext4";
            type = "archive";
            device = "/dev/upgradable_rootfs";
            preserve-attributes = true;
            path = "/";
            sha256 = "$swupdate_get_sha256(@@IMAGE_DEPENDS@@-@@MACHINE@@.rootfs.tar.xz)";
        },
    );

    scripts: (
        {
            filename = "swupdate_install.sh";
            type = "shellscript";
            sha256 = "$swupdate_get_sha256(swupdate_install.sh)";
        }
    );
}
